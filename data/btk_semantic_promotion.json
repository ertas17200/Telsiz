  "policy": {
    "purpose": "Inventory exactly which raw fields can be promoted without inventing semantics. This file does not create a legal permission verdict.",
    "does_not_create_permission": true,
    "current_model_limits": [
      "e.i.r.p. limits are modelled with power_basis=eirp and are never converted to transmitter output power; a request is only compared on the same basis. Mixed-basis or non-single e.i.r.p. values still need review.",
      "Rows containing two power values require a structured multivalue/PEP model before general power promotion.",
      "A3J and J2C remain source-listed but undefined by Tablo 26-1 and are blocked from semantic emission promotion.",
      "Conditional use such as beacon, EME, emergency/cooperation and sub-range emission restrictions requires structured condition modeling rather than free-text flattening."
    ]
  },
